<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <!-- 日志转换规则配置 -->
    <conversionRule conversionWord="clr"
                    class="org.springframework.boot.logging.logback.ColorConverter"/>
    <conversionRule conversionWord="wex"
                    class="org.springframework.boot.logging.logback.WhitespaceThrowableProxyConverter"/>
    <conversionRule conversionWord="wEx"
                    class="org.springframework.boot.logging.logback.ExtendedWhitespaceThrowableProxyConverter"/>
    <conversionRule conversionWord="methodType"
                    class="com.xlf.utility.logger.MethodTypeConverter"/>

    <!-- =============================================== -->
    <!-- 日志模式配置 - 控制台和文件输出格式             -->
    <!-- =============================================== -->
    <property name="LOG_FILE" value="logs/app.log"/>
    <!-- 上下文ID显示模式：绿色显示上下文标识 -->
    <property name="CONTEXT_ID_PATTERN"
              value="%clr(%replace(%X{CONTEXT_ID}){'^(.+)$','[$1]'}){green}"/>

    <property name="CONSOLE_LOG_PATTERN"
              value="${CONSOLE_LOG_PATTERN:-%clr(%d{${LOG_DATEFORMAT_PATTERN:-yyyy-MM-dd HH:mm:ss.SSS}}){faint} %clr(${LOG_LEVEL_PATTERN:-%5p}) %clr(${PID:- }){magenta} %clr(---){faint} %clr([%15.15t]){faint} ${CONTEXT_ID_PATTERN} %clr(%-40.40logger{39}){cyan} %methodType%clr(:){faint} %m%n${LOG_EXCEPTION_CONVERSION_WORD:-%wEx}}"/>

    <property name="CONSOLE_LOG_CHARSET"
              value="${CONSOLE_LOG_CHARSET:-${file.encoding:-UTF-8}}"/>

    <property name="FILE_LOG_PATTERN"
              value="${FILE_LOG_PATTERN:-%d{${LOG_DATEFORMAT_PATTERN:-yyyy-MM-dd HH:mm:ss.SSS}} ${LOG_LEVEL_PATTERN:-%5p} ${PID:- } --- [%t] %replace(%X{CONTEXT_ID}){'^(.+)$','[$1]'} %-40.40logger{39} %methodType : %m%n${LOG_EXCEPTION_CONVERSION_WORD:-%wEx}}"/>

    <property name="FILE_LOG_CHARSET"
              value="${FILE_LOG_CHARSET:-${file.encoding:-UTF-8}}"/>

    <!-- =============================================== -->
    <!-- 第三方库日志级别控制 - 减少噪音输出             -->
    <!-- =============================================== -->
    <!-- Apache Tomcat/Catalina 相关 -->
    <logger name="org.apache.catalina.startup.DigesterFactory" level="ERROR"/>
    <logger name="org.apache.catalina.util.LifecycleBase" level="ERROR"/>
    <logger name="org.apache.coyote.http11.Http11NioProtocol" level="WARN"/>
    <logger name="org.apache.tomcat.util.net.NioSelectorPool" level="WARN"/>

    <!-- SSH 和网络相关 -->
    <logger name="org.apache.sshd.common.util.SecurityUtils" level="WARN"/>

    <!-- Jetty 相关 -->
    <logger name="org.eclipse.jetty.util.component.AbstractLifeCycle" level="ERROR"/>

    <!-- Hibernate 和 Spring Boot 相关 -->
    <logger name="org.hibernate.validator.internal.util.Version" level="WARN"/>
    <logger name="org.springframework.boot.actuate.endpoint.jmx" level="WARN"/>

    <!-- =============================================== -->
    <!-- WebFlux 专用日志级别配置                       -->
    <!-- =============================================== -->
    <!-- WebFlux 响应式组件日志控制 -->
    <logger name="org.springframework.web.reactive" level="WARN"/>
    <logger name="reactor.netty" level="WARN"/>
    <logger name="io.netty" level="WARN"/>

    <!-- =============================================== -->
    <!-- 控制台输出配置 - 开发环境友好的彩色输出         -->
    <!-- =============================================== -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>${CONSOLE_LOG_PATTERN}</pattern>
            <charset>${CONSOLE_LOG_CHARSET}</charset>
        </encoder>
    </appender>

    <!-- =============================================== -->
    <!-- 文件输出配置 - 生产环境日志文件管理             -->
    <!-- =============================================== -->
    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <encoder>
            <pattern>${FILE_LOG_PATTERN}</pattern>
            <charset>${FILE_LOG_CHARSET}</charset>
        </encoder>
        <file>${LOG_FILE}</file>

        <!-- 滚动策略：按时间和大小分割日志文件 -->
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOGBACK_ROLLINGPOLICY_FILE_NAME_PATTERN:-${LOG_FILE}.%d{yyyy-MM-dd}.%i.gz}</fileNamePattern>
            <cleanHistoryOnStart>${LOGBACK_ROLLINGPOLICY_CLEAN_HISTORY_ON_START:-false}</cleanHistoryOnStart>
            <maxFileSize>${LOGBACK_ROLLINGPOLICY_MAX_FILE_SIZE:-10MB}</maxFileSize>
            <totalSizeCap>${LOGBACK_ROLLINGPOLICY_TOTAL_SIZE_CAP:-0}</totalSizeCap>
            <maxHistory>${LOGBACK_ROLLINGPOLICY_MAX_HISTORY:-7}</maxHistory>
        </rollingPolicy>
    </appender>

    <!-- =============================================== -->
    <!-- 根日志配置 - 全局日志级别和输出目标             -->
    <!-- =============================================== -->
    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="FILE"/>
    </root>
</configuration>
